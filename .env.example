# ===========================================
# Atalaia.js Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
#
# Everything optional below ships commented out on purpose. A variable set here
# beats both the console and config.json, so an uncommented placeholder is not
# a harmless example — Atalaia would treat a fake webhook or a fake SMTP host
# as deliberate configuration, turn the matching console section read-only, and
# fail every "Send test" against it.

# ---- Core ----
PORT=3000
NODE_ENV=production
API_KEY=your-secret-api-key-here
LOG_LEVEL=info

# ---- Database ----
DB_PATH=./data/atalaia.db

# ---- Monitoring Schedule ----
# Cron expression for vulnerability scanning (default: every hour)
CRON_SCHEDULE=0 * * * *

# ---- Slack ----
# Configure this from the console (Settings -> Slack) unless a deployment has to
# pin it. Uncomment only with real values.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
#SLACK_SIGNING_SECRET=your-slack-signing-secret

# ---- Microsoft Teams ----
# Channel -> Workflows -> "Post to a channel when a webhook request is received"
#TEAMS_WEBHOOK_URL=

# ---- Telegram ----
# Talk to @BotFather for the token; the chat id is the group, channel or user the
# alerts go to. Configure this from the console (Settings -> Telegram) unless a
# deployment has to pin it.
#TELEGRAM_BOT_TOKEN=123456789:AA...
#TELEGRAM_CHAT_ID=-1001234567890

# ---- Callbacks ----
# Where Slack and Telegram should call back. A real deployment sets PUBLIC_URL
# and needs no tunnel; a laptop has no address to give them, so one is borrowed.
# TUNNEL_PROVIDER: auto | ngrok | cloudflared | none. 'auto' takes ngrok when it
# has a token and Cloudflare's quick tunnel otherwise, which needs no account.
#PUBLIC_URL=https://atalaia.example.com
#TUNNEL_PROVIDER=auto
#NGROK_AUTH_TOKEN=
#NGROK_REGION=auto

# ---- Email Reports ----
# Configure this from the console (Settings -> Email). Setting SMTP_HOST pins the
# whole email configuration to the environment.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
#EMAIL_FROM=atalaia@example.com
#EMAIL_RECIPIENTS=security@example.com,cto@example.com
# Weekly report schedule (default: Monday 9 AM)
WEEKLY_REPORT_CRON=0 9 * * 1

# ---- LLM ----
# Configure this from the console (Settings -> Model). Setting LLM_PROVIDER pins it.
# Provider: ollama | lmstudio | openai | anthropic | gemini | openrouter | groq | custom
#LLM_PROVIDER=
#OPENAI_API_KEY=sk-your-api-key
#OPENAI_MODEL=gpt-4o-mini
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama2

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
