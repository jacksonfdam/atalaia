{
  "name": "atalaia",
  "version": "1.0.0",
  "description": "A Node.js service that monitors security vulnerabilities in real-time and sends alerts to Slack.",
  "main": "src/interface/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/interface/index.js",
    "start": "node src/interface/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ngrok": "^5.0.0-beta.2",
    "node-cron": "3.0.2",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
