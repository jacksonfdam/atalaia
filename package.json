{
  "name": "atalaia",
  "version": "1.1.0",
  "description": "A Node.js service that monitors security vulnerabilities in real-time and sends alerts to Slack, Microsoft Teams and email.",
  "license": "MIT",
  "author": "Jackson Mafra (https://github.com/jacksonfdam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksonfdam/atalaia.git"
  },
  "bugs": {
    "url": "https://github.com/jacksonfdam/atalaia/issues"
  },
  "homepage": "https://github.com/jacksonfdam/atalaia#readme",
  "main": "src/interface/index.js",
  "type": "module",
  "bin": {
    "atalaia": "./bin/atalaia.js"
  },
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.js",
    "up": "./scripts/atalaia.sh up",
    "up:docker": "./scripts/atalaia.sh up --docker",
    "up:local": "./scripts/atalaia.sh up --local",
    "down": "./scripts/atalaia.sh down",
    "status": "./scripts/atalaia.sh status",
    "logs": "./scripts/atalaia.sh logs",
    "doctor": "./scripts/atalaia.sh doctor",
    "dev": "nodemon src/interface/index.js",
    "start": "node src/interface/index.js",
    "build:cli": "tsc -p tsconfig.cli.json",
    "dev:cli": "tsx src/cli/index.tsx",
    "prepare": "pnpm run build:cli",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "start:worker": "node src/interface/worker.js",
    "dev:worker": "nodemon src/interface/worker.js"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/",
      "/dist/"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ngrok/ngrok": "^1.7.0",
    "@simplewebauthn/server": "^13.3.2",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "cloudflared": "^0.7.3",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ink": "^7.1.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "rss-parser": "^3.13.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
