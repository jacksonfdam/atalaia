{
  "name": "atalaia",
  "version": "1.0.0",
  "description": "A Node.js service that monitors security vulnerabilities in real-time and sends alerts to Slack.",
  "main": "src/interface/index.js",
  "type": "module",
  "bin": {
    "atalaia": "./bin/atalaia.js"
  },
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "nodemon src/interface/index.js",
    "start": "node src/interface/index.js",
    "build:cli": "tsc -p tsconfig.cli.json",
    "dev:cli": "tsx src/cli/index.tsx",
    "prepare": "npm run build:cli",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "commander": "^13.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ink": "^5.2.1",
    "ngrok": "^5.0.0-beta.2",
    "node-cron": "3.0.2",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
