{
  "cronSchedule": "0 * * * *",
  "slack": {
    "enabled": false,
    "webhookUrl": "${SLACK_WEBHOOK_URL}"
  },
  "feeds": {
    "cisaJson": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
    "snyk": "https://security.snyk.io/vuln",
    "vuldbRss": "https://vuldb.com/?rss.recent"
  },
  "opencve": {
    "apiUrl": "${OPENCVE_API_URL}",
    "token": "${OPENCVE_API_TOKEN}"
  },
  "providers": [],
  "repositories": {
    "autoScan": false,
    "scanCron": "0 3 * * *",
    "autoFilterFromDeps": true
  },
  "filterSettings": {
    "enabled": true,
    "technologies": [
      "cargo",
      "cocoapods",
      "composer",
      "conan",
      "go",
      "php",
      "maven",
      "npm",
      "nuget",
      "pip",
      "pub",
      "rubygems",
      "swift"
    ]
  }
}