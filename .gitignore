# CLI build output (generated by `npm run build:cli`)
/dist/

# Runtime SQLite database, plus its WAL / shared-memory files
/data/*.db
/data/*.db-wal
/data/*.db-shm

# Local process state written by scripts/atalaia.sh (pids and logs)
/.run/

# Management console: installed packages and built bundle
/ui/node_modules/
/ui/dist/

# Documentation site: installed packages and rendered HTML
/docs/node_modules/
/docs/dist/

.DS_Store
.vercel
.env*

# Anyone who points a local Supabase at this repo gets a supabase/ of CLI state.
# Atalaia does not ship one: it needs a connection string, not a host.
/supabase/
